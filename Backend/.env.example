# Copy this file to .env and fill in real values for local development.
# On Railway, set these as environment variables in the dashboard.

# MongoDB — Railway sets MONGO_URL automatically when you add the MongoDB plugin
# For local dev:
MONGO_URI=mongodb://127.0.0.1:27017/blood-bank

# JWT secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Frontend URL — set to your Railway frontend service URL in production
FRONTEND_URL=http://localhost:5173

# Email credentials (Gmail app password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Optional SMTP overrides. Defaults to Gmail SMTP on port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Node environment
NODE_ENV=development
